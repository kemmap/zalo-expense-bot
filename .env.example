# =================================================================
# Zalo Expense Tracker Bot - Environment Configuration Template
# Sao chép file này thành .env và điền các thông tin tương ứng.
# =================================================================

# Cổng máy chủ Express (Mặc định: 3000)
PORT=3000

# -----------------------------------------------------------------
# Cấu hình Zalo App & Zalo Official Account (OA)
# Lấy thông tin tại: https://developers.zalo.me/
# -----------------------------------------------------------------

# ID của Ứng dụng Zalo (App ID)
ZALO_APP_ID=your_zalo_app_id_here

# Khóa bí mật của Ứng dụng Zalo (App Secret)
ZALO_APP_SECRET=your_zalo_app_secret_here

# ID của Official Account (OA ID)
ZALO_OA_ID=your_zalo_oa_id_here

# Khóa bí mật của OA (OA Secret Key)
ZALO_OA_SECRET_KEY=your_zalo_oa_secret_key_here

# Token làm mới (Refresh Token) từ luồng OAuth 2.0 (có hạn dùng 3 tháng)
ZALO_REFRESH_TOKEN=your_zalo_refresh_token_here

# Access Token hiện tại (hạn dùng 25 giờ, tự động gia hạn bằng Refresh Token)
ZALO_ACCESS_TOKEN=your_zalo_access_token_here

# -----------------------------------------------------------------
# Bảo mật Webhook (Tùy chọn)
# -----------------------------------------------------------------
# Mã xác thực bí mật để kiểm tra tính hợp lệ của request gửi tới Webhook
WEBHOOK_SECRET=your_webhook_secret_key_here
